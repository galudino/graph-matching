#------------------------------------------------------------------------------
# Project
#------------------------------------------------------------------------------

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Modern C/C++ command-line graph_matching project"

OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIRECTORY@"
OUTPUT_LANGUAGE        = English

BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = YES

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
TAB_SIZE               = 4

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#------------------------------------------------------------------------------
# Build / extraction
#------------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO

GENERATE_TODOLIST      = YES
MAX_INITIALIZER_LINES  = 30

#------------------------------------------------------------------------------
# Warnings
#------------------------------------------------------------------------------

QUIET                  = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

#------------------------------------------------------------------------------
# Input
#------------------------------------------------------------------------------

INPUT                  = "@PROJECT_SOURCE_DIR@/components" \
                         "@PROJECT_SOURCE_DIR@/app"
FILE_PATTERNS          = *.hpp *.h *.cpp *.cc *.c
RECURSIVE              = YES

EXCLUDE_PATTERNS       = */build/* \
                         */third_party/* \
                         */vendor/*

EXCLUDE_SYMLINKS       = YES

#------------------------------------------------------------------------------
# Source browsing
#------------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES

REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#------------------------------------------------------------------------------
# Output
#------------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html

GENERATE_LATEX         = NO
GENERATE_XML           = NO

#------------------------------------------------------------------------------
# Diagrams
#------------------------------------------------------------------------------

HAVE_DOT               = YES
CLASS_GRAPH            = YES

CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#------------------------------------------------------------------------------
# Preprocessor
#------------------------------------------------------------------------------

# Hide compiler attributes so declarations parse cleanly.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "GRAPH_MATCHING_PRINTF_FORMAT(format_index,first_arg)="
