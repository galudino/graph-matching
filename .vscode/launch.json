{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "graph_matchingPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching"
            }
        },
        {
            "id": "testsPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching_tests"
            }
        }
    ],
    "configurations": [
        {
            "name": "CMake: Debug graph_matching",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:graph_matchingPath}",
            "args": [
                "${workspaceFolder}/data/test.mtx",
                "${workspaceFolder}/build/test.out",
                "oneWay",
                "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CMake: Debug graph_matching_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:testsPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}