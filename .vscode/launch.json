{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "graphMatchingCPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching_c"
            }
        },
        {
            "id": "graphMatchingCppPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching_cpp"
            }
        },
        {
            "id": "cTestsPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching_c_tests"
            }
        },
        {
            "id": "cAssignmentTestsPath",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "graph_matching_c_assignment_tests"
            }
        }
    ],
    "configurations": [
        {
            "name": "CMake: Debug graph_matching_c (one-way)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:graphMatchingCPath}",
            "args": [
                "${workspaceFolder}/data/test.mtx",
                "${workspaceFolder}/build/test_c.out",
                "one-way",
                "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CMake: Debug graph_matching_c (N-way)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:graphMatchingCPath}",
            "args": [
                "${workspaceFolder}/data/test.mtx",
                "${workspaceFolder}/build/test_c.out",
                "n-way",
                "2",
                "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CMake: Debug graph_matching_cpp (one-way)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:graphMatchingCppPath}",
            "args": [
                "${workspaceFolder}/data/test.mtx",
                "${workspaceFolder}/build/test_cpp.out",
                "one-way",
                "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CMake: Debug graph_matching_cpp (N-way)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:graphMatchingCppPath}",
            "args": [
                "${workspaceFolder}/data/test.mtx",
                "${workspaceFolder}/build/test_cpp.out",
                "n-way",
                "2",
                "2"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CMake: Debug graph_matching_c_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:cTestsPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "CMake: Debug graph_matching_c_assignment_tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:cAssignmentTestsPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
