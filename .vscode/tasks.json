{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "cmake",
            "command": "configure",
            "preset": "${command:cmake.activeConfigurePresetName}",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "cmake",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Clean",
            "type": "cmake",
            "command": "clean",
            "preset": "${command:cmake.activeBuildPresetName}",
            "problemMatcher": []
        },
        {
            "label": "CMake: Clean Rebuild",
            "type": "cmake",
            "command": "cleanRebuild",
            "preset": "${command:cmake.activeBuildPresetName}",
            "problemMatcher": []
        },
        {
            "label": "Run (C): One-Way Matching",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/bin/graph_matching_c",
            "args": [
                "${input:matrix}",
                "${command:cmake.buildDirectory}/one_way_c.out",
                "one-way",
                "${input:threads}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Run (C): N-Way Matching",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/bin/graph_matching_c",
            "args": [
                "${input:matrix}",
                "${command:cmake.buildDirectory}/n_ways_c.out",
                "n-way",
                "${input:hands}",
                "${input:threads}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Run (C): Greedy Matching",
            "type": "process",
            "command": "${command:cmake.buildDirectory}/bin/graph_matching_c",
            "args": [
                "${input:matrix}",
                "${command:cmake.buildDirectory}/greedy_c.out",
                "greedy"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Run (C): Compare One-Way with Reference",
            "type": "process",
            "command": "${workspaceFolder}/scripts/compare_with_reference.sh",
            "args": [
                "${input:matrix}",
                "one-way",
                "${input:threads}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "GRAPH_MATCHING_BIN": "${command:cmake.buildDirectory}/bin/graph_matching_c"
                }
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Run (C): Compare N-Way with Reference",
            "type": "process",
            "command": "${workspaceFolder}/scripts/compare_with_reference.sh",
            "args": [
                "${input:matrix}",
                "n-way",
                "${input:hands}",
                "${input:threads}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "GRAPH_MATCHING_BIN": "${command:cmake.buildDirectory}/bin/graph_matching_c"
                }
            },
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Data: Generate Test Matrices",
            "type": "cmake",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "targets": [
                "generate_matrices_c"
            ],
            "problemMatcher": []
        },
        {
            "label": "Data: Fetch Test Matrices",
            "type": "process",
            "command": "${workspaceFolder}/scripts/fetch_matrices.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Test",
            "type": "cmake",
            "command": "ctest",
            "preset": "${command:cmake.activeTestPresetName}",
            "dependsOn": "CMake: Build",
            "problemMatcher": []
        },
        {
            "label": "Test (C): Assignment",
            "type": "shell",
            "command": "cmake --preset assignment && cmake --build --preset assignment && ctest --preset assignment",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "CMake: Documentation (C)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${command:cmake.buildDirectory}",
                "--target",
                "docs_c"
            ],
            "dependsOn": "CMake: Configure",
            "problemMatcher": []
        },
        {
            "label": "Clang: Format Check",
            "type": "shell",
            "command": "find c/app c/components c/tests cpp/app cpp/components cpp/tests -type f \\( -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \\) -exec clang-format --dry-run --Werror {} +",
            "problemMatcher": []
        },
        {
            "label": "Clang: Format All",
            "type": "shell",
            "command": "find c/app c/components c/tests cpp/app cpp/components cpp/tests -type f \\( -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' \\) -exec clang-format -i {} +",
            "problemMatcher": []
        },
        {
            "label": "Clang: Tidy",
            "type": "shell",
            "command": "run-clang-tidy -quiet -p '${command:cmake.buildDirectory}' '^${workspaceFolder}/(c|cpp)/(app|components|tests)/.*\\.(c|cpp)$'",
            "dependsOn": "CMake: Configure",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "matrix",
            "type": "pickString",
            "description": "Matrix to match (Data: Generate Test Matrices creates data/generated/)",
            "options": [
                "data/test.mtx",
                "data/generated/small.mtx",
                "data/generated/medium.mtx",
                "data/generated/large.mtx",
                "data/dawson5/dawson5.mtx",
                "data/cant/cant.mtx",
                "data/consph/consph.mtx",
                "data/hood/hood.mtx",
                "data/ldoor/ldoor.mtx",
                "data/af_shell10/af_shell10.mtx"
            ],
            "default": "data/test.mtx"
        },
        {
            "id": "threads",
            "type": "pickString",
            "description": "Number of threads",
            "options": [
                "1",
                "2",
                "4",
                "8"
            ],
            "default": "4"
        },
        {
            "id": "hands",
            "type": "pickString",
            "description": "Hands per vertex (N)",
            "options": [
                "2",
                "3",
                "4"
            ],
            "default": "2"
        }
    ]
}
